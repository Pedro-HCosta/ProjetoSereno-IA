# Copie para .env (desenvolvimento) ou cadastre em Configurações do Web App (Azure). Nunca suba o .env.

# Mesmo valor usado pela API Java e pela API .NET (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_ISSUER=sereno-auth
JWT_AUDIENCE=sereno-app
# Como o segredo vira chave: false = texto UTF-8 (igual ao .NET); true = Base64 decodificado. Tem que ser igual ao Java.
JWT_SECRET_BASE64=false

# LLM por API compatível com OpenAI. Padrão: Google Gemini (chave grátis em aistudio.google.com)
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT=10
AI_MAX_TOKENS=2048
# Só para modelos de raciocínio (gpt-oss, Gemini 2.5): menos "pensamento" = mais rápido e menos tokens.
# Deixe vazio para modelos sem raciocínio (ex.: gpt-4o-mini).
AI_REASONING_EFFORT=low
# Por quanto tempo (segundos) a mesma previsão/resposta é reaproveitada sem chamar o LLM de novo
CACHE_TTL=3600
# Groq:   AI_BASE_URL=https://api.groq.com/openai/v1    AI_MODEL=openai/gpt-oss-120b
# OpenAI: AI_BASE_URL=https://api.openai.com/v1         AI_MODEL=gpt-4o-mini

# Opcional: URL da API Java, para buscar nome e categoria dos lugares (sem ela, usa ml/dados/locais.json)
JAVA_API_URL=
# Segundos esperando a API Java (o Render gratuito demora para acordar)
JAVA_TIMEOUT=8
